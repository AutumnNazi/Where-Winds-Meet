---
import { SITE } from '../lib/data';
import SiteSearch from '../components/SiteSearch.astro';
import '../styles/global.css';

interface Props {
  /** 当前导航高亮项的路径前缀，如 /innerways */
  active?: string;
  /** 页面标题（浏览器标签 & 搜索索引） */
  title?: string;
}
const { active, title } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} · ${SITE.subtitle}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script is:inline>
      // 首帧前恢复主题，避免闪烁
      const saved = localStorage.getItem('theme');
      if (saved === 'light') document.documentElement.dataset.theme = 'light';
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="site-title" href="/">燕云<span>资料站</span></a>
        <nav class="site-nav">
          {
            SITE.nav.map((item) => (
              <a
                href={item.href}
                aria-current={active && item.href.startsWith(active) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <SiteSearch />
        <button
          id="theme-toggle"
          class="theme-toggle"
          title="切换亮/暗色"
          aria-label="切换亮暗色主题"
        >
          <span class="icon-dark">🌙</span>
          <span class="icon-light">☀️</span>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="inner">
        <p>
          数据基于社区整理（
          <a href="https://github.com/greydust/where-builds-meet" target="_blank" rel="noopener"
            >where-builds-meet</a
          >，GPL-3.0），游戏内容版权归《燕云十六声》官方所有；本站为非商业资料站。
        </p>
        <p>
          词条中文名与效果描述尚缺官方文案，英文处标注「中文名待补」；效果为机器转译，请以游戏内实际为准。
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .theme-toggle {
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 50%;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    font-size: 0.85rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .theme-toggle:hover {
    border-color: var(--accent-dim);
  }
  :global(html[data-theme='light']) .theme-toggle .icon-dark { display: block; }
  :global(html[data-theme='light']) .theme-toggle .icon-light { display: none; }
  .theme-toggle .icon-dark { display: none; }
  .theme-toggle .icon-light { display: block; }
</style>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const toLight = root.dataset.theme !== 'light';
    if (toLight) root.dataset.theme = 'light';
    else delete root.dataset.theme;
    localStorage.setItem('theme', toLight ? 'light' : 'dark');
  });
</script>
