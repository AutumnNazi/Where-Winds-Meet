---
import Base from '../../layouts/Base.astro';
import {
  martialArts,
  martialArtZhDesc,
  martialArtZhInfo,
  weapons,
} from '../../lib/data';
import { displayName } from '../../lib/format';

// 武学本名的中英对照候选（供筛选条展示）：武器名 + 全部
const weaponOptions = ['全部', ...weapons.map((w) => displayName(w.name).text)];
---

<Base active="/martial-arts" title="武学">
  <h1>武学</h1>
  <p class="page-desc">
    共 {Object.keys(martialArts).length} 套武学，按武器分类。每套武学的强化树详见详情页。
  </p>

  <div class="filter-bar" id="weapon-filter">
    {weaponOptions.map((w, i) => (
      <button class="filter-btn" data-weapon={weapons[i - 1]?.key ?? '全部'} class:list={{ active: i === 0 }}>
        {w}
      </button>
    ))}
  </div>

  {
    weapons.map((weapon) => {
      const wName = displayName(weapon.name);
      return (
        <section data-weapon={weapon.key}>
          <h2>
            {wName.text}
            <span class={wName.zhMissing ? 'muted' : 'muted en-name'}>
              {weapon.name.en}
            </span>
          </h2>
          <div class="card-grid">
            {weapon.martialArts.map((id) => {
              const ma = martialArts[id];
              const zh = martialArtZhInfo(id);
              const zhDesc = zh ? martialArtZhDesc(zh.zh) : null;
              return (
                <a class="card" href={`/martial-arts/${ma.id}/`}>
                  <div class="title">
                    {zh ? zh.zh : <span class="zh-missing">{ma.name.en}</span>}
                    {zh?.confidence === 'medium' && (
                      <span class="pending-tag">（待确认）</span>
                    )}
                  </div>
                  <div class="sub">{ma.name.en}</div>
                  {zhDesc?.effects?.length ? (
                    <div class="sub desc-preview">{zhDesc.effects[0].slice(0, 40)}…</div>
                  ) : (
                    <div class="sub">
                      {ma.talents.filter((t) => t.entries.length > 0).length} 层强化
                    </div>
                  )}
                </a>
              );
            })}
          </div>
        </section>
      );
    })
  }
</Base>

<style>
  .en-name {
    font-weight: 400;
    font-size: 0.85rem;
    margin-left: 0.5rem;
  }
  .pending-tag {
    color: var(--text-faint);
    font-size: 0.75rem;
    font-weight: 400;
  }
  .desc-preview {
    max-width: 100%;
  }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.6rem;
  }
  .filter-btn {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    color: var(--text-dim);
    font-family: inherit;
    font-size: 0.85rem;
    padding: 0.2rem 0.8rem;
    cursor: pointer;
  }
  .filter-btn:hover {
    border-color: var(--accent-dim);
  }
  .filter-btn.active {
    background: var(--panel-2);
    border-color: var(--accent-dim);
    color: var(--accent);
  }
</style>

<script>
  // 武器筛选：按 section 的 data-weapon 显隐分组
  document.getElementById('weapon-filter')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-btn');
    if (!btn) return;
    document.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    const key = btn.dataset.weapon ?? '全部';
    document.querySelectorAll<HTMLDivElement>('section[data-weapon]').forEach((sec) => {
      sec.style.display = key === '全部' || sec.dataset.weapon === key ? '' : 'none';
    });
  });
</script>
