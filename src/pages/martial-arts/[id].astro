---
import Base from '../../layouts/Base.astro';
import EffectList from '../../components/EffectList.astro';
import {
  affixLookup,
  martialArts,
  martialArtZhDesc,
  martialArtZhInfo,
  skillsBySource,
  weaponByKey,
} from '../../lib/data';
import { displayName, renderEffectEntry } from '../../lib/format';

export function getStaticPaths() {
  return Object.values(martialArts).map((ma) => ({
    params: { id: ma.id },
    props: { ma },
  }));
}

const { ma } = Astro.props;
const zh = martialArtZhInfo(ma.id);
const zhDesc = zh ? martialArtZhDesc(zh.zh) : null;
const weapon = weaponByKey(ma.weapon);
const relatedSkills = skillsBySource(ma.id);
const activeTalents = ma.talents.filter((t) => t.entries.length > 0);
---

<Base active="/martial-arts" title={(zh ? zh.zh : ma.name.en) + " · 武学"}>
  <p><a href="/martial-arts/">← 返回武学列表</a></p>
  <h1>
    {zh ? zh.zh : ma.name.en}
    {zh?.confidence === 'medium' && <span class="pending-tag">（待确认）</span>}
  </h1>
  <p class="page-desc">
    {ma.name.en}
    {zh?.confidence === 'medium' && ' · 中文名为社区对照结果，待游戏内确认'}
  </p>

  <div>
    武器类别：
    <span class="tag accent">{weapon ? displayName(weapon.name).text : ma.weapon}</span>
  </div>

  {
    zhDesc?.effects?.length ? (
      <>
        <h2>武学效果</h2>
        <div class="panel">
          <ul class="wuxue-effects">
            {zhDesc.effects.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </div>
      </>
    ) : null
  }

  <h2>强化树</h2>
  {
    activeTalents.length === 0 ? (
      <p class="muted">暂无强化层数据。</p>
    ) : (
      <table>
        <thead>
          <tr>
            <th>层级</th>
            <th>强化效果</th>
          </tr>
        </thead>
        <tbody>
          {activeTalents.map((talent) => (
            <tr>
              <td class="level-cell">{talent.level}</td>
              <td>
                {talent.entries.map((entry) => {
                  const entryName = entry.nameZh ?? (entry.data as { name?: string }).name;
                  const renders = ((entry.data as { effect?: unknown[] }).effect ?? []).map(
                    (e) => renderEffectEntry(e, affixLookup),
                  );
                  const isZh = Boolean(entry.nameZh);
                  return (
                    <div class="talent-entry">
                      {entryName && (
                        <div class={isZh ? 'talent-name' : 'talent-name zh-missing'}>
                          {entryName}
                        </div>
                      )}
                      <EffectList items={renders} emptyText="（无效果文本）" />
                    </div>
                  );
                })}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }

  {
    relatedSkills.length > 0 && (
      <>
        <h2>关联技能</h2>
        <p class="muted">
          本武学的技能动作数据共 {relatedSkills.length} 条（伤害系数等详见
          <a href="/skills/">技能总表</a>）。
        </p>
      </>
    )
  }
</Base>

<style>
  .level-cell {
    color: var(--accent);
    font-weight: 600;
    width: 3.5rem;
    text-align: center;
  }
  .talent-entry {
    margin-bottom: 0.6rem;
  }
  .talent-entry:last-child {
    margin-bottom: 0;
  }
  .talent-name {
    color: var(--text);
    font-weight: 600;
  }
  .wuxue-effects {
    margin: 0;
    padding-left: 1.2rem;
  }
  .wuxue-effects li {
    margin: 0.3rem 0;
  }
  .pending-tag {
    color: var(--text-faint);
    font-size: 0.8rem;
    font-weight: 400;
  }
</style>
