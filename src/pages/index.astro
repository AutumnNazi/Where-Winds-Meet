---
import Base from '../layouts/Base.astro';
import { attunements, builds, innerways, martialArts, skills } from '../lib/data';

const stats = [
  { href: '/innerways/', label: '心法', en: 'Inner Ways', count: Object.keys(innerways).length, desc: 'T0–T6 分层效果与适配流派' },
  { href: '/martial-arts/', label: '武学', en: 'Martial Arts', count: Object.keys(martialArts).length, desc: '按武器分类的技能强化树' },
  { href: '/skills/', label: '技能', en: 'Skills', count: skills.length, desc: '技能数值、消耗与动作数据' },
  { href: '/attunements/', label: '词条', en: 'Attunements', count: attunements.length, desc: '调律词条、装备词条池与数值上限' },
  { href: '/builds/', label: '配装', en: 'Builds', count: builds.length, desc: '流派配装：心法、套装与词条搭配' },
];
---

<Base>
  <h1>燕云资料站</h1>
  <p class="page-desc">《燕云十六声》（Where Winds Meet）配装、心法、武学、技能与词条资料库。</p>

  <div class="card-grid">
    {
      stats.map((s) => (
        <a class="card" href={s.href}>
          <div class="title">
            {s.label} <span class="muted">{s.en}</span>
          </div>
          <div class="sub">{s.desc}</div>
          <div class="count">{s.count} 条数据</div>
        </a>
      ))
    }
  </div>

  <div class="notice">
    <p><strong>数据覆盖现状</strong>（诚实标注，帮助判断哪些内容可信）：</p>
    <ul class="coverage">
      <li>心法：全 60 部名录（11 流派 + 通用三档），24 部有中文效果与获取途径，18 部有 T0–T6 结构化数值</li>
      <li>武学：20 套强化树完整，12 套有中文名与效果描述，8 套中文名待补</li>
      <li>技能：129 条带伤害系数/冷却（168 条中文名）；效果描述文本缺失</li>
      <li>词条：54 条调律词条 + 装备词条池 + 数值上限（名字暂为英文，无中文来源）</li>
      <li>中文描述来自玩家整理的游戏文案（17173/灰机 wiki），以游戏内实际为准</li>
    </ul>
    <p>数据更新：结构化数值 <code>npm run import:ref</code>、心法名录 <code>npm run import:huiji</code>、中文描述 <code>npm run parse:17173</code>。</p>
  </div>
</Base>

<style>
  .count {
    margin-top: 0.5rem;
    color: var(--accent);
    font-size: 0.85rem;
  }
  code {
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.05rem 0.35rem;
    font-size: 0.82em;
  }
</style>
