---
import Base from '../../layouts/Base.astro';
import {
  innerwayCatalogTotal,
  innerwayZhCatalog,
  innerwayZhInfo,
  innerways,
  pathByTag,
} from '../../lib/data';
import { displayName, displayNameVerified } from '../../lib/format';

// 按适配流派分组：心法的 tags 为流派 tag（如 StonesplitMight），多流派归入首组并保留全部标签
const groups = new Map<string, { groupName: string; items: typeof list }>();
const list = Object.values(innerways);
for (const iw of list) {
  const tag = iw.tags[0] ?? '';
  const key = tag || 'none';
  const path = tag ? pathByTag(tag) : undefined;
  const groupName = path ? displayName(path.name).text : tag || '未标注流派';
  if (!groups.has(key)) groups.set(key, { groupName, items: [] });
  groups.get(key)!.items.push(iw);
}

const commonLabels: Record<string, string> = {
  金色: '金色品质',
  紫色: '紫色品质',
  蓝色: '蓝色品质',
};
---

<Base active="/innerways">
  <h1>心法</h1>
  <p class="page-desc">共 {list.length} 部心法。T0–T6 为心法品级层级，详见各心法页。</p>

  {
    [...groups.entries()].map(([key, { groupName, items }]) => (
      <section>
        <h2>{groupName}</h2>
        <div class="card-grid">
          {items.map((iw) => {
            const name = displayNameVerified(iw.name, innerwayZhInfo(iw.id));
            return (
              <a class="card" href={`/innerways/${iw.id}/`}>
                <div class={name.zhMissing ? 'title zh-missing' : 'title'}>
                  {name.text}
                  {name.zhPending && (
                    <span class="pending-tag">（待确认）</span>
                  )}
                </div>
                <div class="sub">
                  {iw.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                <div class="sub">
                  {iw.tiers.filter(Boolean).length} 层有效果
                </div>
              </a>
            );
          })}
        </div>
      </section>
    ))
  }

  <h2>心法全名录（{innerwayCatalogTotal.factionInnerways + innerwayCatalogTotal.commonInnerways} 部）</h2>
  <p class="muted">
    来自
    <a
      href="https://yy16s.huijiwiki.com/wiki/流派"
      target="_blank"
      rel="noopener">灰机 wiki 流派页</a
    >（CC BY-SA，{innerwayZhCatalog.fetchedAt} 抓取）；带「·」暂无本站详情页的以纯文本列出。
  </p>
  {
    innerwayZhCatalog.factions.map((f) => (
      <div class="panel catalog-row">
        <strong>{f.key}：</strong>
        {f.innerways.join('、')}
      </div>
    ))
  }
  <div class="panel catalog-row">
    {
      Object.entries(innerwayZhCatalog.common).map(([quality, names]) => (
        <div>
          <strong>{commonLabels[quality] ?? quality}：</strong>
          {names.join('、')}
        </div>
      ))
    }
  </div>
</Base>

<style>
  .pending-tag {
    color: var(--text-faint);
    font-size: 0.75rem;
    font-weight: 400;
  }
  .catalog-row {
    padding: 0.6rem 1rem;
    margin-bottom: 0.5rem;
    font-size: 0.92rem;
  }
</style>
