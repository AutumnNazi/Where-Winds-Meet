---
import Base from '../../layouts/Base.astro';
import {
  innerwayCatalogList,
  innerwayCatalogTotal,
} from '../../lib/data';

// 按流派分组（目录自带中文流派名），通用心法再按品质分级
const groups = new Map<string, typeof innerwayCatalogList>();
for (const entry of innerwayCatalogList) {
  const key = entry.quality ? `${entry.faction}·${entry.quality}` : entry.faction;
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(entry);
}
// 筛选维度：流派（含「全部」）
const factions = ['全部', ...new Set(innerwayCatalogList.map((e) => e.faction))];
---

<Base active="/innerways" title="心法">
  <h1>心法</h1>
  <p class="page-desc">
    全 {innerwayCatalogList.length} 部心法（{innerwayCatalogTotal.factions} 大流派 +
    通用），其中 {innerwayCatalogList.filter((e) => e.desc?.effect).length} 部有中文效果描述、
    {innerwayCatalogList.filter((e) => e.tiers).length} 部有结构化数值。
  </p>

  <div class="filter-bar" id="faction-filter">
    {factions.map((f) => (
      <button class="filter-btn" data-faction={f} class:list={{ active: f === '全部' }}>
        {f}
      </button>
    ))}
  </div>

  {
    [...groups.entries()].map(([groupName, items]) => (
      <section data-faction={items[0].faction}>
        <h2>{groupName}（{items.length}）</h2>
        <div class="card-grid">
          {items.map((entry) => (
            <a class="card" href={`/innerways/${encodeURIComponent(entry.slug)}/`}>
              <div class="title">
                {entry.zhName}
                {entry.confidence === 'medium' && (
                  <span class="pending-tag">（待确认）</span>
                )}
              </div>
              {entry.desc?.category && <div class="sub">{entry.desc.category}</div>}
              {entry.desc?.effect && (
                <div class="sub desc-preview">{entry.desc.effect.slice(0, 42)}…</div>
              )}
              <div class="sub">
                {entry.tiers
                  ? '含 T0–T6 数值效果'
                  : entry.desc?.effect
                    ? '中文描述'
                    : '基本信息'}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <div class="notice">
    <p>
      名录来源：
      <a href="https://yy16s.huijiwiki.com/wiki/流派" target="_blank" rel="noopener">灰机 wiki 流派页</a>
      （CC BY-SA）；中文效果描述来自
      <a
        href="http://news.17173.com/content/01142025/015407897.shtml"
        target="_blank"
        rel="noopener">17173 全武器攻略</a>
      （玩家整理的游戏内文案）。标注「待确认」的中文名为社区对照结果。
    </p>
  </div>
</Base>

<style>
  .pending-tag {
    color: var(--text-faint);
    font-size: 0.75rem;
    font-weight: 400;
  }
  .desc-preview {
    max-width: 100%;
  }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.6rem;
  }
  .filter-btn {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    color: var(--text-dim);
    font-family: inherit;
    font-size: 0.85rem;
    padding: 0.2rem 0.8rem;
    cursor: pointer;
  }
  .filter-btn:hover {
    border-color: var(--accent-dim);
  }
  .filter-btn.active {
    background: var(--panel-2);
    border-color: var(--accent-dim);
    color: var(--accent);
  }
</style>

<script>
  // 流派筛选：按 section 的 data-faction 显隐分组
  const filter = (faction: string) => {
    document.querySelectorAll<HTMLDivElement>('section[data-faction]').forEach((sec) => {
      sec.style.display = faction === '全部' || sec.dataset.faction === faction ? '' : 'none';
    });
  };
  document.getElementById('faction-filter')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-btn');
    if (!btn) return;
    document.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    filter(btn.dataset.faction ?? '全部');
  });
</script>
