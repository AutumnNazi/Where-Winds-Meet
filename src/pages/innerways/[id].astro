---
import Base from '../../layouts/Base.astro';
import EffectList from '../../components/EffectList.astro';
import {
  affixLookup,
  innerwayCatalogEntryBySlug,
  innerwayCatalogList,
} from '../../lib/data';

export function getStaticPaths() {
  return innerwayCatalogList.map((entry) => ({
    params: { id: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const tierLabels = ['T0', 'T1', 'T2', 'T3', 'T4', 'T5', 'T6'];
// 同流派关联推荐（排除自身，最多 8 个；通用心法按同品质推荐）
const related = innerwayCatalogList
  .filter(
    (e) =>
      e.slug !== entry.slug &&
      e.faction === entry.faction &&
      (e.quality ?? null) === (entry.quality ?? null),
  )
  .slice(0, 8);
---

<Base active="/innerways" title={entry.zhName + " · 心法"}>
  <p><a href="/innerways/">← 返回心法列表</a></p>
  <h1>{entry.zhName}</h1>
  <p class="page-desc">
    {entry.enName ?? ''}
    {entry.faction ? ` · ${entry.faction}` : ''}{entry.quality ? ` · ${entry.quality}` : ''}
    {entry.confidence === 'medium' && ' · 中文名为社区对照结果，待游戏内确认'}
  </p>

  {
    entry.desc && (
      <div class="panel">
        {entry.desc.category && (
          <div class="desc-row">
            <strong>分类：</strong>
            {entry.desc.category}
          </div>
        )}
        {entry.desc.effect && (
          <div class="desc-row">
            <strong>效果：</strong>
            {entry.desc.effect}
          </div>
        )}
        {entry.desc.obtain && (
          <div class="desc-row">
            <strong>获取：</strong>
            {entry.desc.obtain}
          </div>
        )}
      </div>
    )
  }

  {
    entry.tiers ? (
      <>
        <h2>分层效果（T0–T6）</h2>
        <div class="notice">
          效果文本由机器数据转译，未识别结构以原文展示；正式描述以游戏内为准。
        </div>
        <table>
          <thead>
            <tr>
              <th>层级</th>
              <th>效果（新增部分以 <span class="diff-mark">＋</span> 标记）</th>
            </tr>
          </thead>
          <tbody>
            {entry.tiers.map((tier, i) => (
              <tr>
                <td class="tier-cell">{tierLabels[i]}</td>
                <td>
                  <EffectList tier={tier} affixLookup={affixLookup} diffAgainst={entry.tiers[i - 1] ?? null} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    ) : (
      !entry.desc && (
        <div class="notice">该心法的描述与数值待补充，欢迎对照游戏内文案录入。</div>
      )
    )
  }

  {
    related.length > 0 && (
      <>
        <h2>{entry.quality ? '同品质心法' : '同流派心法'}</h2>
        <div class="card-grid">
          {related.map((e) => (
            <a class="card" href={`/innerways/${encodeURIComponent(e.slug)}/`}>
              <div class="title">{e.zhName}</div>
              {e.desc?.category && <div class="sub">{e.desc.category}</div>}
              <div class="sub">
                {e.tiers ? '含数值效果' : e.desc?.effect ? '中文描述' : '基本信息'}
              </div>
            </a>
          ))}
        </div>
      </>
    )
  }
</Base>

<style>
  .tier-cell {
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
    width: 4rem;
  }
  .desc-row {
    padding: 0.25rem 0;
  }
</style>
